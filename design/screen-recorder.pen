      "name": "[SYSTEM][CONVENTION]",
      "enabled": false,
      "metadata": {
        "type": "convention",
        "version": "2261ab8fc9",
        "data": {
          "version": 1,
          "grammar": "[TYPE][NAME][VARIANT]",
          "regex": "^\\[([A-Z][A-Z0-9_]*)\\](?:\\[([A-Z0-9_]+)\\])?(?:\\[([A-Z0-9_.]+)\\])?$",
          "rules": {
            "TYPE": "From the families below. Required.",
            "NAME": "What it is for (EMAIL, SUBMIT, SETTINGS). MASTER on a component origin.",
            "VARIANT": "Optional. On a MASTER: the structural variant (DANGER, COMPACT). On an instance: its axis values, dot-joined in axis order (TYPING, ERROR, ACTIVE.HOVER). mode and anno never appear in names.",
            "parts": "Children inside a component are plain PascalCase parts (Label, Icon, Value, Error text), never bracketed.",
            "wrappers": "Plain layout frames inside a screen (Row, Main, Body) stay PascalCase too."
          },
          "families": {
            "INPUT": {
              "color": "#EC4899",
              "types": [
                "INPUT_TEXT",
                "INPUT_SELECT",
