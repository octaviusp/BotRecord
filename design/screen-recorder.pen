    {
      "type": "frame",
      "id": "Dp4b6",
      "x": 0,
      "y": -120,
      "name": "[SYSTEM][HELPERS]",
      "enabled": false,
      "metadata": {
        "type": "agent-helpers",
        "version": "2261ab8fc9",
        "src": "(() => {\nconst C = Get(n => n.metadata?.type === \"convention\" ? n.metadata.data : undefined)[0] || {families: {}, axes: {}}\nconst up = s => String(s).toUpperCase().replace(/[^A-Z0-9.]+/g, \"_\").replace(/^_+|_+$/g, \"\")\nconst fam = type => Object.keys(C.families).find(f => C.families[f].types.includes(type))\nconst N = (type, name, variant) => `[${up(type)}]` + (name ? `[${up(name)}]` : \"\") + (variant ? `[${up(variant)}]` : \"\")\nconst RE = /^\\[([A-Z][A-Z0-9_]*)\\](?:\\[([A-Z0-9_]+)\\])?(?:\\[([A-Z0-9_.]+)\\])?$/\nconst parse = s => { const m = RE.exec(s || \"\"); return m && {type: m[1], name: m[2], variant: m[3]} }\nconst glob = g => new RegExp(\"^\" + g.replace(/[.+?^${}()|\\\\]/g, \"\\\\$&\").replace(/\\[/g, \"\\\\[\").replace(/\\]/g, \"\\\\]\").replace(/\\*/g, \"[A-Z0-9_.]*\"))\nconst find = (pattern, root) => { const re = pattern instanceof RegExp ? pattern : glob(pattern); const v = n => re.test(n.name || \"\") ? {id: n.id, name: n.name} : undefined; return root ? Get(root, v) : Get(v) }\nconst anno = type => { const f = fam(type); if (!f) throw new Error(\"Unknown TYPE \" + type + \": add it to the convention\"); return {type: \"shadow\", shadowType: \"outer\", offset: {x: 0, y: 0}, blur: 10, color: \"$type-\" + f.toLowerCase(), enabled: \"$anno-on\"} }\nconst withAnno = (type, o) => ({...o, effect: [...[].concat(o.effect || []), anno(type)]})\nreturn {\nC, N, parse, find, fam, anno,\nT: (content, o = {}) => ({type: \"text\", name: o.name || String(content).slice(0, 32), content, fontFamily: \"$font-sans\", fontSize: 14, fill: \"$fg\", ...o}),\nP: (content, o = {}) => ({type: \"text\", name: o.name || String(content).slice(0, 32), content, fontFamily: \"$font-sans\", fontSize: 14, fill: \"$muted\", textGrowth: \"fixed-width\", width: \"fill_container\", ...o}),\nF: (name, o = {}) => ({type: \"frame\", name, ...o}),\nV: (name, o = {}) => ({type: \"frame\", name, layout: \"vertical\", ...o}),\nI: (icon, o = {}) => ({type: \"icon\", name: o.name || \"Icon\", library: \"lucide\", icon, width: 16, height: 16, fill: \"$fg\", ...o}),\nR: (ref, name, o = {}) => ({type: \"ref\", ref, name, ...o}),\nM: (type, o = {}, variant) => withAnno(type, {type: \"frame\", name: N(type, \"MASTER\", variant), reusable: true, ...o}),\nD: (base, type, variant, o = {}) => ({type: \"ref\", ref: base, reusable: true, name: N(type, \"MASTER\", variant), ...o}),\nuse: (ref, type, name, axes = {}, o = {}) => ({type: \"ref\", ref, name: N(type, name, Object.values(axes).join(\".\")), ...(Object.keys(axes).length ? {theme: {...axes}} : {}), ...o}),\nrestate: (id, axes) => { const n = Get(id, {depth: 0}), p = parse(n.name); if (!p) throw new Error(\"Not a convention name: \" + n.name); const theme = {...(n.theme || {}), ...axes}; const keys = Object.keys(theme).filter(k => k !== \"mode\" && k !== \"anno\"); Update(id, {theme, name: N(p.type, p.name, keys.map(k => theme[k]).join(\".\"))}) },\nlint: root => { const bad = []; const v = (n, c) => { if (c.depth === 0 && root) return; if (!/^\\[/.test(n.name || \"\")) return; const q = parse(n.name); if (!q) bad.push(\"syntax: \" + n.name); else if (!fam(q.type)) bad.push(\"unknown TYPE: \" + n.name); else if (n.reusable && q.name !== \"MASTER\") bad.push(\"component without MASTER: \" + n.name) }; root ? Get(root, v) : Get(v); return bad },\ninventory: root => { const c = {}; const v = n => { const m = /^\\[([A-Z0-9_]+)\\]/.exec(n.name || \"\"); if (m) c[m[1]] = (c[m[1]] || 0) + 1 }; root ? Get(root, v) : Get(v); return Object.entries(c).map(([k, n]) => k + \"×\" + n).join(\" \") },\nannotate: (id, on = true) => { const n = Get(id, {depth: 0}); Update(id, {theme: {...(n.theme || {}), anno: on ? \"on\" : \"off\"}}) },\nput: (width, height, o = {}) => FindEmptySpace({width, height, padding: 80, ...o}),\naxis: (axis, map, type = \"color\") => ({type, value: Object.entries(map).map(([k, value]) => ({value, theme: {[axis]: k}}))}),\nmodes: (light, dark, type = \"color\") => ({type, value: [{value: light, theme: {mode: \"light\"}}, {value: dark, theme: {mode: \"dark\"}}]}),\nids: o => Print(JSON.stringify(o))\n}\n})()"
      },
      "width": 200,
      "height": 40
    },
